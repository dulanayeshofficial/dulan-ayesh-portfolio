# Cloudflare static-asset headers.
# Requests that match a static asset are served without invoking worker.js,
# so headers for those must be declared here rather than in the Worker.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Images and fonts are content-stable: cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
